# Console startup settings; the Settings page manages SSO/Login runtime settings.
PORT=7004
LOG_LEVEL=info
ADMINS_FILE=./data/admins.json
SESSION_SECRET=change-me
# Must match proxy, sso, and login.
INTERNAL_API_TOKEN=change-me

# Docker DNS names; use localhost instead when running services as local processes.
PROXY_BASE_URL=http://proxy:3000
SSO_BASE_URL=http://sso:7001
LOGIN_BASE_URL=http://login:7003
