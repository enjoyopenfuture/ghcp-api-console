# Server and internal service access.
PORT=7003
LOG_LEVEL=info
DB_PATH=./data/login.sqlite
INTERNAL_API_TOKEN=change-me
PROXY_BASE_URL=http://localhost:3000
LOG_DIR=./logs/login

# GitHub Device Flow.
GITHUB_OAUTH_CLIENT_ID=Ov23li8tweQw6odWQebz
GITHUB_OAUTH_SCOPE=read:user
OPENCODE_VERSION=1.84.0
# OPENCODE_USER_AGENT=opencode/1.0.0

# Browser authorization; provider comes from task ssoType or CLI --sso-type.
SSO_URL=http://localhost:7001/login
AUTH_HEADLESS=true
AUTH_DEBUG_ARTIFACT_DIR=.auth-debug

# Optional Azure-only setting.
# AZURE_STAY_SIGNED_IN=false

# Concurrency, auth timeout, and debug switches are managed in Console Settings.

# Optional selector overrides for GitHub/SSO pages.
# AUTH_DEVICE_CODE_INPUT_SELECTOR=
# AUTH_DEVICE_CODE_SUBMIT_SELECTOR=
# AUTH_GITHUB_LOGIN_INPUT_SELECTOR=
# AUTH_GITHUB_LOGIN_SUBMIT_SELECTOR=
# AUTH_GITHUB_SSO_SUBMIT_SELECTOR=
# AUTH_SSO_USERNAME_INPUT_SELECTOR=
# AUTH_SSO_PASSWORD_INPUT_SELECTOR=
# AUTH_SSO_SUBMIT_SELECTOR=
# AUTH_AZURE_USERNAME_INPUT_SELECTOR=
# AUTH_AZURE_NEXT_SUBMIT_SELECTOR=
# AUTH_AZURE_PASSWORD_INPUT_SELECTOR=
# AUTH_AZURE_SIGN_IN_SUBMIT_SELECTOR=
# AUTH_AZURE_STAY_SIGNED_IN_YES_SELECTOR=
# AUTH_AZURE_STAY_SIGNED_IN_NO_SELECTOR=
# AUTH_GITHUB_AUTHORIZE_SUBMIT_SELECTOR=
