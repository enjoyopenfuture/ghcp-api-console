# Server and storage.
PORT=3000
LOG_LEVEL=info
STORAGE_DRIVER=sqlite
DB_PATH=./data/proxy.sqlite
IDENTITY_INIT_LEASE_SECONDS=900

# Optional MySQL settings; uncomment and configure when STORAGE_DRIVER=mysql.
# MYSQL_URL=mysql://username:password@server_address:port/db_name
## Set false only when an administrator has already prepared the business tables.
# MYSQL_AUTO_MIGRATE=true
# MYSQL_CONNECTION_LIMIT=10
# MYSQL_SSL_MODE accepts disabled, required, or verify-ca; verify-ca requires MYSQL_SSL_CA_PATH.
# MYSQL_SSL_MODE=disabled
# MYSQL_SSL_CA_PATH=

# Public API and internal service access.
API_KEY=change-me
IDENTITY_HEADER=X-User-Identity
IDENTITY_HEADER_REQUIRED=true
## Default Claude Code mode; requests can override with X-Claude-Code-Optimized.
## CLAUDE_CODE_OPTIMIZED defaults to false in code.
CLAUDE_CODE_OPTIMIZED=true
INTERNAL_API_TOKEN=change-me
SSO_BASE_URL=http://localhost:7001
LOGIN_BASE_URL=http://localhost:7003
# GitHub web origin; https://<subdomain>.ghe.com for GHE.com data residency.
GITHUB_BASE_URL=https://github.com
# Suffix stripped from new identities to derive SSO user names (GitHub.com EMU logins are <ssoUser>_<shortcode>).
# Ignored on GHE.com, where GH logins carry no suffix.
ENTERPRISE_SHORTCODE=octo

# Retention and diagnostics are startup settings, not Console runtime settings.
REQUEST_STATS_PER_ACCOUNT_LIMIT=2
PROXY_ERROR_DIAGNOSTICS_ENABLED=true
PROXY_ERROR_DIAGNOSTICS_DIR=./data/error-diagnostics
PROXY_ERROR_DIAGNOSTICS_REDACT=false
PROXY_ERROR_DIAGNOSTICS_MAX_FILE_MB=50
PROXY_ERROR_DIAGNOSTICS_MAX_FILES=5
# Multi-instance diagnostics; PROXY_INSTANCE_ID defaults to HOSTNAME.
PROXY_ERROR_DIAGNOSTICS_SHARED=false
PROXY_INSTANCE_ID=

# GHE.com data residency: https://copilot-api.<subdomain>.ghe.com
COPILOT_API_BASE_URL=https://api.githubcopilot.com
OPENCODE_VERSION=1.18.4
GITHUB_API_VERSION=2026-06-01

# Image upload: inline base64 images are uploaded as Copilot attachments and sent as URLs.
# PROXY_IMAGE_UPLOAD_MODE accepts always, auto, or off.
PROXY_IMAGE_UPLOAD_MODE=always
# Inbound JSON body limit in MiB; clients still send inline base64 images to the proxy.
PROXY_MAX_REQUEST_BODY_MB=64
