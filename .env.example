# Copy this file to .env before running docker compose.
# Replace every change-me value before deploying outside local development.

LOG_LEVEL=info

# Shared internal/API secrets.
API_KEY=change-me-proxy-api-key
INTERNAL_API_TOKEN=change-me-internal-token
SESSION_SECRET=change-me-session-secret

# Host ports exposed by docker compose.
PROXY_PORT=3000
SSO_PORT=7001
LOGIN_PORT=7003
CONSOLE_PORT=7004

# Proxy public API and OpenCode-compatible Copilot authentication.
IDENTITY_HEADER=X-User-Identity
IDENTITY_HEADER_REQUIRED=true
# Default Claude Code mode; requests can override with X-Claude-Code-Optimized.
CLAUDE_CODE_OPTIMIZED=true
REQUEST_STATS_PER_ACCOUNT_LIMIT=100

GITHUB_OAUTH_CLIENT_ID=Ov23li8tweQw6odWQebz
GITHUB_OAUTH_SCOPE=read:user
COPILOT_API_BASE_URL=https://api.githubcopilot.com
OPENCODE_VERSION=1.18.4
GITHUB_API_VERSION=2026-06-01

# SSO/SAML public settings.
SSO_PUBLIC_BASE_URL=http://localhost:7001
SSO_CERT_DIR=./certs
SP_ENTITY_ID=https://github.com/enterprises/acme
SP_ACS_URL=https://github.com/enterprises/acme/saml/consume
SSO_EMAIL_DOMAIN=customsso.com
USER_PREFIX=user

# GitHub Enterprise / SCIM / Copilot settings.
ENTERPRISE_SLUG=acme
ENTERPRISE_SHORTCODE=octo
GITHUB_API_BASE_URL=https://api.github.com
SCIM_BASE_URL=https://api.github.com/scim/v2/enterprises/acme
SCIM_TOKEN=change-me-scim-token
SCIM_REQUEST_DELAY_MS=250
SCIM_MAX_RETRIES=3
SCIM_RETRY_BASE_DELAY_MS=1000
GITHUB_COPILOT_SEAT_PAT=change-me-github-pat

# Login worker settings.
LOGIN_CONCURRENCY=1
LOGIN_SSO_URL=http://public-sso-service:7001
LOGIN_SSO_PROVIDER=custom
AUTH_HEADLESS=true
AUTH_TIMEOUT_MS=60000
