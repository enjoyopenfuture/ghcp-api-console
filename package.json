{
  "name": "ghcp-api-learning-prod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/packages/*",
    "src/proxy",
    "src/sso",
    "src/login",
    "src/console",
    "src/mock-github"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:deploy": "npm --workspace @ghcp/shared run build && npm --workspace @ghcp/proxy run build && npm --workspace @ghcp/sso run build && npm --workspace @ghcp/login run build && npm --workspace @ghcp/console run build",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:upgrade",
    "typecheck:deploy": "npm --workspace @ghcp/shared run typecheck && npm --workspace @ghcp/proxy run typecheck && npm --workspace @ghcp/sso run typecheck && npm --workspace @ghcp/login run typecheck && npm --workspace @ghcp/console run typecheck && npm run typecheck:upgrade",
    "typecheck:upgrade": "tsc -p upgrade/sqlite-to-mysql/tsconfig.json",
    "start:proxy": "npm --workspace @ghcp/proxy run start",
    "start:prod:proxy": "npm --workspace @ghcp/proxy run start:prod",
    "start:sso": "npm --workspace @ghcp/sso run start",
    "start:prod:sso": "npm --workspace @ghcp/sso run start:prod",
    "start:login": "npm --workspace @ghcp/login run start",
    "start:prod:login": "npm --workspace @ghcp/login run start:prod",
    "login:token": "npm --silent --workspace @ghcp/login run login:token --",
    "start:console": "npm --workspace @ghcp/console run start",
    "start:prod:console": "npm --workspace @ghcp/console run start:prod",
    "start:mock-github": "npm --workspace @ghcp/mock-github run start",
    "compose:build": "docker compose build",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "mysql:test:up": "docker compose -f docker-compose.mysql.yml up -d --wait",
    "mysql:test:down": "docker compose -f docker-compose.mysql.yml down",
    "test:mysql": "npm --workspace @ghcp/proxy run test:mysql",
    "test:upgrade:mysql": "tsx --test upgrade/sqlite-to-mysql/migrate.integration.test.ts",
    "upgrade:sqlite-to-mysql": "tsx upgrade/sqlite-to-mysql/index.ts",
    "validate:health": "bash scripts/validate-health.sh"
  },
  "dependencies": {
    "@authenio/samlify-node-xmllint": "^2.0.0",
    "better-sqlite3": "^12.5.0",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "mysql2": "^3.24.2",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "samlify": "^2.13.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.0"
  }
}
